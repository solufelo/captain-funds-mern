# Copy to server/.env. Everything is optional for local development:
# with no MONGODB_URL the API starts an in-memory MongoDB and seeds the
# fictional demo data; with no Stripe key, donations are labelled mock payments.

# --- Core -------------------------------------------------------------------
PORT=4100
# Comma-separated list of front-end origins allowed by CORS. The first one is
# also where Stripe redirects back to after checkout.
CLIENT_URL=http://localhost:4150
# Required in production (16+ random characters). Dev uses a random per-run secret.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Database ---------------------------------------------------------------
# MongoDB Atlas or local mongod. Leave blank for the in-memory dev database.
MONGODB_URL=
# Pin the in-memory database port (optional).
MONGO_MEMORY_PORT=
# Seed the fictional demo campaigns + demo logins into MONGODB_URL on boot.
SEED_DEMO=false

# --- Payments (Stripe TEST mode only) ---------------------------------------
# Leave blank for mock payments. Only sk_test_ keys are accepted.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4100/api/donations/webhook`
STRIPE_WEBHOOK_SECRET=
CURRENCY=cad

# --- Optional services --------------------------------------------------------
# Image uploads (Cloudinary). Without these the form takes an image URL instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Outgoing email (any SMTP). Without these, emails are logged and skipped.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Generates labelled "simulated" donations every 15s for live demos.
ENABLE_SIMULATION=false
# Timezone for daily analytics buckets.
REPORT_TIMEZONE=America/Toronto
# Set to 1 when running behind a reverse proxy (accurate rate limiting).
TRUST_PROXY=
