# Copy to client/.env.local if you need to override defaults.

# Full-stack mode (default): the client calls /api, which the dev server
# proxies to the Express API. Point this at a deployed API in production.
VITE_API_URL=
VITE_SOCKET_URL=
# Where the dev proxy forwards /api and /socket.io.
API_PROXY_TARGET=http://localhost:4100

# Browser-only demo (the Netlify build): no API, fictional data kept in
# localStorage, payments always mocked.
VITE_DEMO_MODE=false
